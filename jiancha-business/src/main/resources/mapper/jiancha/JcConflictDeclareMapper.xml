<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiancha.biz.archive.mapper.JcConflictDeclareMapper">

    <resultMap id="JcConflictDeclareResult" type="com.jiancha.biz.archive.domain.JcConflictDeclare">
        <id     property="declareId"    column="declare_id"/>
        <result property="personId"     column="person_id"/>
        <result property="declareType"  column="declare_type"/>
        <result property="declareYear"  column="declare_year"/>
        <result property="declareDate"  column="declare_date"/>
        <result property="status"       column="status"/>
        <result property="verifyBy"     column="verify_by"/>
        <result property="verifyTime"   column="verify_time"/>
        <result property="verifyResult" column="verify_result"/>
        <result property="createBy"     column="create_by"/>
        <result property="createTime"   column="create_time"/>
        <result property="updateBy"     column="update_by"/>
        <result property="updateTime"   column="update_time"/>
        <result property="remark"       column="remark"/>
    </resultMap>

    <sql id="selectDeclareVo">
        select declare_id, person_id, declare_type, declare_year, declare_date, status,
               verify_by, verify_time, verify_result, create_by, create_time, update_by,
               update_time, del_flag, remark
        from jc_conflict_declare
    </sql>

    <select id="selectJcConflictDeclareList" parameterType="com.jiancha.biz.archive.domain.JcConflictDeclare" resultMap="JcConflictDeclareResult">
        <include refid="selectDeclareVo"/>
        <where>
            del_flag = '0'
            <if test="personId != null">and person_id = #{personId}</if>
            <if test="declareType != null and declareType != ''">and declare_type = #{declareType}</if>
            <if test="declareYear != null">and declare_year = #{declareYear}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by declare_id desc
    </select>

    <select id="selectByPersonId" parameterType="Long" resultMap="JcConflictDeclareResult">
        <include refid="selectDeclareVo"/>
        where person_id = #{personId} and del_flag = '0'
        order by declare_year desc, declare_id desc
    </select>

    <select id="selectByDeclareId" parameterType="Long" resultMap="JcConflictDeclareResult">
        <include refid="selectDeclareVo"/>
        where declare_id = #{declareId} and del_flag = '0'
    </select>

    <insert id="insertJcConflictDeclare" parameterType="com.jiancha.biz.archive.domain.JcConflictDeclare" useGeneratedKeys="true" keyProperty="declareId">
        insert into jc_conflict_declare (
            <trim suffixOverrides=",">
                <if test="personId != null">person_id,</if>
                <if test="declareType != null and declareType != ''">declare_type,</if>
                <if test="declareYear != null">declare_year,</if>
                <if test="declareDate != null">declare_date,</if>
                <if test="status != null and status != ''">status,</if>
                <if test="verifyBy != null and verifyBy != ''">verify_by,</if>
                <if test="verifyTime != null">verify_time,</if>
                <if test="verifyResult != null and verifyResult != ''">verify_result,</if>
                <if test="createBy != null and createBy != ''">create_by,</if>
                <if test="remark != null and remark != ''">remark,</if>
                create_time
            </trim>
        ) values (
            <trim suffixOverrides=",">
                <if test="personId != null">#{personId},</if>
                <if test="declareType != null and declareType != ''">#{declareType},</if>
                <if test="declareYear != null">#{declareYear},</if>
                <if test="declareDate != null">#{declareDate},</if>
                <if test="status != null and status != ''">#{status},</if>
                <if test="verifyBy != null and verifyBy != ''">#{verifyBy},</if>
                <if test="verifyTime != null">#{verifyTime},</if>
                <if test="verifyResult != null and verifyResult != ''">#{verifyResult},</if>
                <if test="createBy != null and createBy != ''">#{createBy},</if>
                <if test="remark != null and remark != ''">#{remark},</if>
                sysdate()
            </trim>
        )
    </insert>

    <update id="updateJcConflictDeclare" parameterType="com.jiancha.biz.archive.domain.JcConflictDeclare">
        update jc_conflict_declare
        <trim prefix="SET" suffixOverrides=",">
            <if test="declareType != null and declareType != ''">declare_type = #{declareType},</if>
            <if test="declareYear != null">declare_year = #{declareYear},</if>
            <if test="declareDate != null">declare_date = #{declareDate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="verifyBy != null and verifyBy != ''">verify_by = #{verifyBy},</if>
            <if test="verifyTime != null">verify_time = #{verifyTime},</if>
            <if test="verifyResult != null">verify_result = #{verifyResult},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where declare_id = #{declareId}
    </update>

    <update id="deleteJcConflictDeclareByDeclareId" parameterType="Long">
        update jc_conflict_declare set del_flag = '2', update_time = sysdate() where declare_id = #{declareId}
    </update>

</mapper>
