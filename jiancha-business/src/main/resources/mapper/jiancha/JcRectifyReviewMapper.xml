<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiancha.biz.rectify.mapper.JcRectifyReviewMapper">

    <resultMap id="JcRectifyReviewResult" type="com.jiancha.biz.rectify.domain.JcRectifyReview">
        <id     property="reviewId"   column="review_id"/>
        <result property="issueId"    column="issue_id"/>
        <result property="reviewType" column="review_type"/>
        <result property="result"     column="result"/>
        <result property="opinion"    column="opinion"/>
        <result property="reviewer"   column="reviewer"/>
        <result property="reviewTime" column="review_time"/>
    </resultMap>

    <select id="selectReviewByIssueId" parameterType="Long" resultMap="JcRectifyReviewResult">
        select review_id, issue_id, review_type, result, opinion, reviewer, review_time
        from jc_rectify_review
        where issue_id = #{issueId}
        order by review_time asc, review_id asc
    </select>

    <insert id="insertReview" parameterType="com.jiancha.biz.rectify.domain.JcRectifyReview" useGeneratedKeys="true" keyProperty="reviewId">
        insert into jc_rectify_review (issue_id, review_type, result, opinion, reviewer, review_time)
        values (#{issueId}, #{reviewType}, #{result}, #{opinion}, #{reviewer}, sysdate())
    </insert>

    <delete id="deleteReviewByIssueId" parameterType="Long">
        delete from jc_rectify_review where issue_id = #{issueId}
    </delete>

</mapper>
