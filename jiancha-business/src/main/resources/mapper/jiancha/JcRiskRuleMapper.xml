<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiancha.biz.risk.mapper.JcRiskRuleMapper">

    <resultMap id="JcRiskRuleResult" type="com.jiancha.biz.risk.domain.JcRiskRule">
        <id     property="ruleId"        column="rule_id"/>
        <result property="ruleCode"      column="rule_code"/>
        <result property="ruleName"      column="rule_name"/>
        <result property="ruleType"      column="rule_type"/>
        <result property="description"   column="description"/>
        <result property="threshold"     column="threshold"/>
        <result property="thresholdUnit" column="threshold_unit"/>
        <result property="alertLevel"    column="alert_level"/>
        <result property="status"        column="status"/>
        <result property="createBy"      column="create_by"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateBy"      column="update_by"/>
        <result property="updateTime"    column="update_time"/>
        <result property="remark"        column="remark"/>
    </resultMap>

    <sql id="selectRuleCols">
        select rule_id, rule_code, rule_name, rule_type, description, threshold, threshold_unit,
               alert_level, status, create_by, create_time, update_by, update_time, remark
        from jc_risk_rule
    </sql>

    <select id="selectJcRiskRuleList" parameterType="com.jiancha.biz.risk.domain.JcRiskRule" resultMap="JcRiskRuleResult">
        <include refid="selectRuleCols"/>
        <where>
            <if test="ruleCode != null and ruleCode != ''">
                rule_code = #{ruleCode}
            </if>
            <if test="ruleType != null and ruleType != ''">
                and rule_type = #{ruleType}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="ruleName != null and ruleName != ''">
                and rule_name like concat('%', #{ruleName}, '%')
            </if>
        </where>
        order by rule_code asc
    </select>

    <select id="selectEnabledRules" resultMap="JcRiskRuleResult">
        <include refid="selectRuleCols"/>
        where status = '0'
        order by rule_code asc
    </select>

    <select id="selectJcRiskRuleByRuleId" parameterType="Long" resultMap="JcRiskRuleResult">
        <include refid="selectRuleCols"/>
        where rule_id = #{ruleId}
    </select>

    <insert id="insertJcRiskRule" parameterType="com.jiancha.biz.risk.domain.JcRiskRule" useGeneratedKeys="true" keyProperty="ruleId">
        insert into jc_risk_rule (rule_code, rule_name, rule_type, description, threshold,
                                  threshold_unit, alert_level, status, remark, create_by, create_time)
        values (#{ruleCode}, #{ruleName}, #{ruleType}, #{description}, #{threshold},
                #{thresholdUnit}, #{alertLevel}, #{status}, #{remark}, #{createBy}, sysdate())
    </insert>

    <update id="updateJcRiskRule" parameterType="com.jiancha.biz.risk.domain.JcRiskRule">
        update jc_risk_rule
        <set>
            <if test="ruleName != null and ruleName != ''">rule_name = #{ruleName},</if>
            <if test="ruleType != null and ruleType != ''">rule_type = #{ruleType},</if>
            <if test="description != null">description = #{description},</if>
            <if test="threshold != null">threshold = #{threshold},</if>
            <if test="thresholdUnit != null">threshold_unit = #{thresholdUnit},</if>
            <if test="alertLevel != null and alertLevel != ''">alert_level = #{alertLevel},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_by = #{updateBy},
            update_time = sysdate()
        </set>
        where rule_id = #{ruleId}
    </update>

    <delete id="deleteJcRiskRuleByRuleId" parameterType="Long">
        delete from jc_risk_rule where rule_id = #{ruleId}
    </delete>

</mapper>
