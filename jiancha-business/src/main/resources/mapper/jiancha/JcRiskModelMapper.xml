<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiancha.biz.risk.mapper.JcRiskModelMapper">

    <resultMap id="JcRiskModelResult" type="com.jiancha.biz.risk.domain.JcRiskModel">
        <id     property="modelId"      column="model_id"/>
        <result property="positionName" column="position_name"/>
        <result property="factorCode"   column="factor_code"/>
        <result property="factorName"   column="factor_name"/>
        <result property="weight"       column="weight"/>
        <result property="description"  column="description"/>
        <result property="status"       column="status"/>
        <result property="createBy"     column="create_by"/>
        <result property="createTime"   column="create_time"/>
        <result property="remark"       column="remark"/>
    </resultMap>

    <sql id="selectModelCols">
        select model_id, position_name, factor_code, factor_name, weight, description,
               status, create_by, create_time, remark
        from jc_risk_model
    </sql>

    <select id="selectJcRiskModelList" parameterType="com.jiancha.biz.risk.domain.JcRiskModel" resultMap="JcRiskModelResult">
        <include refid="selectModelCols"/>
        <where>
            <if test="positionName != null and positionName != ''">
                position_name = #{positionName}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by position_name asc, factor_code asc
    </select>

    <select id="sumWeightByPosition" resultType="java.util.Map">
        select position_name as name, least(sum(weight), 100) as value
        from jc_risk_model
        where status = '0'
        group by position_name
        order by value desc
    </select>

    <select id="selectJcRiskModelByModelId" parameterType="Long" resultMap="JcRiskModelResult">
        <include refid="selectModelCols"/>
        where model_id = #{modelId}
    </select>

    <insert id="insertJcRiskModel" parameterType="com.jiancha.biz.risk.domain.JcRiskModel" useGeneratedKeys="true" keyProperty="modelId">
        insert into jc_risk_model (position_name, factor_code, factor_name, weight, description, status, remark, create_by, create_time)
        values (#{positionName}, #{factorCode}, #{factorName}, #{weight}, #{description}, #{status}, #{remark}, #{createBy}, sysdate())
    </insert>

    <update id="updateJcRiskModel" parameterType="com.jiancha.biz.risk.domain.JcRiskModel">
        update jc_risk_model
        <set>
            <if test="positionName != null and positionName != ''">position_name = #{positionName},</if>
            <if test="factorCode != null and factorCode != ''">factor_code = #{factorCode},</if>
            <if test="factorName != null and factorName != ''">factor_name = #{factorName},</if>
            <if test="weight != null">weight = #{weight},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where model_id = #{modelId}
    </update>

    <delete id="deleteJcRiskModelByModelId" parameterType="Long">
        delete from jc_risk_model where model_id = #{modelId}
    </delete>

</mapper>
