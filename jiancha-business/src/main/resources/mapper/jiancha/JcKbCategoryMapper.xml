<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiancha.biz.knowledge.mapper.JcKbCategoryMapper">

    <resultMap id="JcKbCategoryResult" type="com.jiancha.biz.knowledge.domain.JcKbCategory">
        <id     property="categoryId" column="category_id"/>
        <result property="parentId"   column="parent_id"/>
        <result property="ancestors"  column="ancestors"/>
        <result property="catName"    column="cat_name"/>
        <result property="catType"    column="cat_type"/>
        <result property="orderNum"   column="order_num"/>
        <result property="status"     column="status"/>
        <result property="docCount"   column="doc_count"/>
        <result property="createBy"   column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy"   column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark"     column="remark"/>
    </resultMap>

    <sql id="selectCategoryVo">
        select c.category_id, c.parent_id, c.ancestors, c.cat_name, c.cat_type, c.order_num,
               c.status, c.create_by, c.create_time, c.update_by, c.update_time, c.remark,
               (select count(*) from jc_kb_document d
                 where d.category_id = c.category_id and d.del_flag = '0') as doc_count
        from jc_kb_category c
    </sql>

    <select id="selectJcKbCategoryList" parameterType="com.jiancha.biz.knowledge.domain.JcKbCategory" resultMap="JcKbCategoryResult">
        <include refid="selectCategoryVo"/>
        <where>
            c.del_flag = '0'
            <if test="catName != null and catName != ''">
                and c.cat_name like concat('%', #{catName}, '%')
            </if>
            <if test="catType != null and catType != ''">
                and c.cat_type = #{catType}
            </if>
            <if test="status != null and status != ''">
                and c.status = #{status}
            </if>
            <if test="parentId != null">
                and c.parent_id = #{parentId}
            </if>
        </where>
        order by c.parent_id, c.order_num
    </select>

    <select id="selectJcKbCategoryAll" resultMap="JcKbCategoryResult">
        <include refid="selectCategoryVo"/>
        where c.del_flag = '0' and c.status = '0'
        order by c.parent_id, c.order_num
    </select>

    <select id="selectJcKbCategoryById" parameterType="Long" resultMap="JcKbCategoryResult">
        <include refid="selectCategoryVo"/>
        where c.category_id = #{categoryId} and c.del_flag = '0'
    </select>

    <select id="selectChildCount" parameterType="Long" resultType="int">
        select count(*) from jc_kb_category where parent_id = #{categoryId} and del_flag = '0'
    </select>

    <select id="selectDocCount" parameterType="Long" resultType="int">
        select count(*) from jc_kb_document where category_id = #{categoryId} and del_flag = '0'
    </select>

    <insert id="insertJcKbCategory" parameterType="com.jiancha.biz.knowledge.domain.JcKbCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into jc_kb_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">parent_id,</if>
            <if test="ancestors != null">ancestors,</if>
            <if test="catName != null and catName != ''">cat_name,</if>
            <if test="catType != null">cat_type,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">#{parentId},</if>
            <if test="ancestors != null">#{ancestors},</if>
            <if test="catName != null and catName != ''">#{catName},</if>
            <if test="catType != null">#{catType},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateJcKbCategory" parameterType="com.jiancha.biz.knowledge.domain.JcKbCategory">
        update jc_kb_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="ancestors != null">ancestors = #{ancestors},</if>
            <if test="catName != null and catName != ''">cat_name = #{catName},</if>
            <if test="catType != null">cat_type = #{catType},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where category_id = #{categoryId}
    </update>

    <update id="deleteJcKbCategoryById" parameterType="Long">
        update jc_kb_category set del_flag = '2', update_time = sysdate() where category_id = #{categoryId}
    </update>

    <update id="deleteJcKbCategoryByIds" parameterType="String">
        update jc_kb_category set del_flag = '2', update_time = sysdate() where category_id in
        <foreach item="categoryId" collection="array" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </update>

</mapper>
