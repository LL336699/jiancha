<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jiancha.biz.rectify.mapper.JcRectifyTaskMapper">

    <resultMap id="JcRectifyTaskResult" type="com.jiancha.biz.rectify.domain.JcRectifyTask">
        <id     property="taskId"       column="task_id"/>
        <result property="issueId"      column="issue_id"/>
        <result property="measure"      column="measure"/>
        <result property="ownerName"    column="owner_name"/>
        <result property="planDate"     column="plan_date"/>
        <result property="doneDate"     column="done_date"/>
        <result property="evidencePath" column="evidence_path"/>
        <result property="status"       column="status"/>
        <result property="createBy"     column="create_by"/>
        <result property="createTime"   column="create_time"/>
    </resultMap>

    <select id="selectTaskByIssueId" parameterType="Long" resultMap="JcRectifyTaskResult">
        select task_id, issue_id, measure, owner_name, plan_date, done_date, evidence_path, status,
               create_by, create_time
        from jc_rectify_task
        where issue_id = #{issueId}
        order by task_id asc
    </select>

    <select id="countByIssueId" parameterType="Long" resultType="java.util.Map">
        select count(1) as task_count,
               sum(case when status = '2' then 1 else 0 end) as task_done_count
        from jc_rectify_task
        where issue_id = #{issueId}
    </select>

    <insert id="insertTask" parameterType="com.jiancha.biz.rectify.domain.JcRectifyTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into jc_rectify_task (issue_id, measure, owner_name, plan_date, done_date, evidence_path, status, create_by, create_time)
        values (#{issueId}, #{measure}, #{ownerName}, #{planDate}, #{doneDate}, #{evidencePath},
                <choose>
                    <when test="status != null and status != ''">#{status}</when>
                    <otherwise>'0'</otherwise>
                </choose>,
                #{createBy}, sysdate())
    </insert>

    <update id="updateTask" parameterType="com.jiancha.biz.rectify.domain.JcRectifyTask">
        update jc_rectify_task
        <set>
            <if test="measure != null and measure != ''">measure = #{measure},</if>
            <if test="ownerName != null">owner_name = #{ownerName},</if>
            <if test="planDate != null">plan_date = #{planDate},</if>
            <if test="doneDate != null">done_date = #{doneDate},</if>
            <if test="evidencePath != null">evidence_path = #{evidencePath},</if>
            <if test="status != null and status != ''">status = #{status},</if>
        </set>
        where task_id = #{taskId}
    </update>

    <delete id="deleteTaskByTaskId" parameterType="Long">
        delete from jc_rectify_task where task_id = #{taskId}
    </delete>

    <delete id="deleteTaskByIssueId" parameterType="Long">
        delete from jc_rectify_task where issue_id = #{issueId}
    </delete>

</mapper>
